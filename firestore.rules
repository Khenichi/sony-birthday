rules_version = '2';
service cloud.firestore {
 match /databases/{database}/documents {
  match /rsvps/{rsvpId} {
   allow create: if request.auth == null
     && request.resource.data.keys().hasOnly(['name','attendance','createdAt'])
     && request.resource.data.keys().hasAll(['name','attendance','createdAt'])
     && request.resource.data.name is string
     && request.resource.data.name.size() >= 2
     && request.resource.data.name.size() <= 90
     && request.resource.data.attendance in ['yes','no']
     && request.resource.data.createdAt == request.time;
   allow read: if request.auth != null && request.auth.uid == "PASTE_ADMIN_USER_UID";
   allow update, delete: if false;
  }
 }
}
